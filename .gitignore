# Standalone android/ ignores (also listed in parent .gitignore when co-located)
/target/
/.gradle/
/.kotlin/
**/build/
/local.properties
/captures/
/e2e-results/
/bbreceiptkit/src/main/jniLibs/
# The whole tree is generated by build-android.sh, one directory per UniFFI
# namespace. Ignore the tree, not a named namespace: pinning
# bb_receipt_ffi/ meant bb_mobile_ffi/ arrived untracked when the second
# namespace appeared.
/bbreceiptkit/src/main/kotlin/uniffi/
/bbreceiptkit/src/main/kotlin/com/beanbeaver/bbreceiptkit/BuildInfo.kt
/app/src/main/assets/models/
# Copied from the repo root by the syncLegalDocs Gradle task — the root files
# are the originals; these are build output.
/app/src/main/assets/legal/
/models/*.onnx
*.apk
*.aab
# Upload-signing secrets — never commit. Config lives in keystore.properties;
# the keystore itself is a *.jks/*.keystore. See keystore.properties.example.
/keystore.properties
*.jks
*.keystore
*.iml
.idea/
.DS_Store

# foss in-app camera: DocQuadNet weights and the ONNX Runtime *Java* bindings.
# Same rule as the PP-OCRv5 models and bbreceiptkit's jniLibs above — binaries
# are built or fetched, never committed, so F-Droid can build from source.
/app/src/foss/assets/docquad/
/app/src/foss/jniLibs/
/app/src/foss/libs/
