<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Scanning and parsing are fully on-device; the network is used only by an
         export the user asks for (GitHub sync in `github/`, which talks to
         api.github.com over HttpURLConnection).

         Declared explicitly even though play-services-mlkit merges the same
         permission in transitively — relying on that merge means dropping or
         swapping the ML Kit dependency silently breaks every export with a
         SecurityException, with nothing failing at compile time. The foss
         flavour has no ML Kit at all, so this declaration is what keeps GitHub
         export working there; it is load-bearing, not belt-and-braces. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera optional for a later document-scanner screen; photo picker needs none. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".BeanBeaverApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeanBeaver">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.BeanBeaver">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the generated Money Manager .xlsx to a share target without
             exposing a file:// path. Scoped by res/xml/file_paths.xml to
             cache/exports only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
